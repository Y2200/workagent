# ==========================================
# Docker 构建上下文排除
#
# 本项目两个镜像都用仓库根作为构建上下文：
#   backend  : Dockerfile          （只需 src/ + requirements.prod.txt）
#   frontend : Dockerfile.frontend （需 frontend/ 源码 + deploy/nginx/ 配置）
# 因此这里按"两者都不需要"来排除；镜像内不得包含任何秘密 / 数据 / 测试内容
# ==========================================

# 敏感配置（绝对禁止进入镜像）
.env
.env.*
*.pem
*.key
*.crt
*.p12
secret*
credential*
token*
password*

# 版本控制
.git
.gitignore

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 数据 / 日志 / 测试知识库（禁止进镜像）
data/
logs/
knowledge/
reports/
ci-reports/
docker/
*.log

# 前端：源码与 deploy/nginx 配置需进构建上下文，依赖与产物不进
frontend/node_modules/
frontend/dist/
npm-debug.log*

# 部署运行态文件（宿主机侧，绝不进镜像）
deploy/.last_deploy
deploy/.deploy_history

# Dockerfile 本身与部署文档（由 -f 单独读取）
Dockerfile
Dockerfile.frontend
.dockerignore
*.md
docs/

# 其他环境文件
requirements.txt
pyproject.toml
uv.lock
CHANGELOG.md

# IDE / 其他
.idea/
.vscode/
.claude/
*.tmp
.DS_Store
