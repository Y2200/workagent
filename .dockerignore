# ==========================================
# Docker 构建上下文排除
# 镜像不得包含任何秘密 / 数据 / 测试内容 / 文档
# ==========================================

# 敏感配置（绝对禁止进入镜像）
.env
.env.*
*.pem
*.key
*.crt
*.p12
secret*
credential*
token*
password*

# 版本控制
.git
.gitignore

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 数据 / 日志 / 测试知识库（禁止进镜像）
data/
logs/
knowledge/
reports/
docker/
*.log

# 前端（不进后端镜像）
frontend/
node_modules/

# 部署与文档（宿主机侧）
deploy/
Dockerfile
.dockerignore

# 项目文档 / 环境
*.md
docs/
requirements.txt
pyproject.toml
uv.lock
CHANGELOG.md

# IDE / 其他
.idea/
.vscode/
.claude/
*.tmp
.DS_Store
