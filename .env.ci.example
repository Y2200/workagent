# CI 测试环境变量模板（GitHub Actions test job 使用；不含真实值）
# 本文件仅供文档参考 —— .github/workflows/ci.yml 直接在 workflow env 中配置同名变量。
# 本地如需复刻 CI 测试环境，可 `cp .env.ci.example .env.ci` 后填值，再
# `set -a; source .env.ci; set +a; python -m work_agent.scripts.run_all_tests`

# --- 数据库（开发 docker-compose.yml 的 work-postgres）---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/work_agent

# --- 向量库 / 对象存储 / 缓存（开发 compose：milvus-standalone / work-minio）---
MILVUS_URI=http://localhost:19530
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=work-documents

# --- LLM（DeepSeek，key 用 GitHub Secret LLM_API_KEY 注入）---
DOUBAO_API_KEY=your_deepseek_api_key
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_TEMPERATURE=0.2

# --- 关闭非必要的定时/邮件（测试隔离）---
EMAIL_ENABLED=false
TASK_REMINDER_ENABLED=false
