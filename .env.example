# ==========================================
# Work Agent 配置模板
# 复制为 .env 并填写真实值，切勿提交真实密钥
# 生产环境（腾讯云 Ubuntu）：
#   - Docker 内部服务名：postgres / redis / work-minio / milvus-standalone
#   - 全部密码必须强随机（见 deploy/README.md 生成命令）
# ==========================================

# ======================
# 企业微信（暂未正式接入，可留空）
# ======================

WECHAT_CORP_ID=
WECHAT_SECRET=
WECHAT_TOKEN=
WECHAT_AGENT_ID=

# ======================
# 大模型（生产必填）
# ======================

DOUBAO_API_KEY=your_llm_api_key
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_TEMPERATURE=0.2

# ======================
# Redis（生产必填，强口令）
# 开发默认：redis://localhost:6379/0
# 生产（Docker 内）：redis://:<REDIS_PASSWORD>@redis:6379/0
# ======================

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=change_me_redis_password

# ======================
# Milvus（P6-1）
# 开发默认：http://localhost:19530
# 生产（Docker 内）：http://milvus-standalone:19530
# ======================

MILVUS_URI=http://localhost:19530

# ======================
# PostgreSQL（生产必填，禁止明文弱口令）
# 开发默认：localhost:5432
# 生产（Docker 内）：postgres:5432
# ======================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=work_agent
DATABASE_URL=postgresql+psycopg2://postgres:change_me@localhost:5432/work_agent

# ======================
# MinIO（应用文档存储，生产必填，禁止默认口令）
# 开发默认：localhost:9002
# 生产（Docker 内）：work-minio:9000（不暴露公网端口）
# ======================

MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=change_me_minio_access
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET=work-documents
MINIO_SECURE=false

# ======================
# Milvus 内部对象存储（生产 compose 强制注入，禁止默认口令）
# ======================

MILVUS_MINIO_USER=change_me_milvus_minio_user
MILVUS_MINIO_PASSWORD=change_me_milvus_minio_password

# ======================
# JWT 认证（生产必填，强随机密钥）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# ======================

JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ======================
# 初始管理员（首次 init-prod.sh 使用，生产改为强口令）
# ======================

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# ======================
# 租户（单租户占位，默认空）
# ======================

TENANT_ID=

# ======================
# CORS 允许来源（P6-1）
# 逗号分隔；生产填 https://wkcp.online
# 留空 = 开发宽松放行（*）
# ======================

CORS_ORIGINS=https://wkcp.online

# ======================
# 成本估算（元 / 1K tokens）
# ======================

MODEL_COST_PER_1K_TOKENS=0.001

# ======================
# 审计日志保留天数
# ======================

AUDIT_LOG_RETENTION_DAYS=180

# ======================
# Prompt 管理
# ======================

PROMPT_CACHE_ENABLED=true
# PROMPT_PATH=可覆盖（默认 src/work_agent/prompts）
